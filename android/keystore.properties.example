# Copy to keystore.properties (git-ignored) to sign release builds with your own key.
# Without this file, `assembleRelease` signs with the Android debug key so the APK
# still installs; such a build is for testing, not for a store listing.
storeFile=keystore/nakshatra-release.jks
storePassword=CHANGE_ME
keyAlias=nakshatra
keyPassword=CHANGE_ME
